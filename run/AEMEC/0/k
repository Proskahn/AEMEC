FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "20";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 1 -3 -1 0 0 0];

internalField   uniform 1;

boundaryField
{
    interconnect0
    {
        type         zeroGradient;
    }
    interconnectSides
    {
        type         zeroGradient;
    }
    anodeInlet
    {
        type         fixedValue;
        //value        uniform 0.0692;
        value        uniform 1e-15;    //disallow outward diffusion at inlet
                                       // value 0 causes harmonic averaging FPE
    }
    anodeOutlet
    {
        type         zeroGradient;
    }
    anodeSides
    {
        type         zeroGradient;
    }
    anodeGDLSides
    {
        type         zeroGradient;
    }
    electrolyteSides
    {
        type         zeroGradient;
    }
    cathodeGDLSides
    {
        type         zeroGradient;
    }
    cathodeSides
    {
        type         zeroGradient;
    }
    cathodeInlet
    {
        type         fixedValue;
        //value        uniform 0.432;
        value        uniform 1e-15;    //disallow outward diffusion at inlet
                                       // value 0 causes harmonic averaging FPE
    }
    cathodeOutlet
    {
        type         zeroGradient;
    }
    interconnect1Sides
    {
        type         zeroGradient;
    }
    interconnect1
    {
        type         zeroGradient;
    }

    anodeInletSides
    {
        type            zeroGradient;
    }

    anodeOutletSides
    {
        type            zeroGradient;
    }

    cathodeInletSides
    {
        type            zeroGradient;
    }

    cathodeOutletSides
    {
        type            zeroGradient;
    }
}


