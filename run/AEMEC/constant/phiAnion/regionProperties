FoamFile
{
    version         2.0;
    format          ascii;
    class           dictionary;
    object          cellProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//- Add information here

control          false;
relax           0.0;
electricDiagnostics true;

// The ionic-potential equation has only Neumann boundaries. Its absolute
// level is therefore selected so the anode and cathode reaction currents are
// equal: integral(J_ion)dV = I_anode - I_cathode = 0.
currentBalance
{
    active                  true;
    // This is the compatibility condition for a singular all-Neumann
    // Poisson equation, so it must be much tighter than an engineering
    // convergence tolerance on the reported electrode current.
    absoluteTolerance       1e-12; // A
    relativeTolerance       1e-10;
    initialPotentialStep    0.01;  // V
    maxPotentialStep        0.25;  // V
    maxIterations           80;
    kineticsCorrectors      1;
    failOnNonConvergence    true;

    // Damped Newton update for the spatial potential. The cap prevents a
    // clipped Butler-Volmer cell (zero local derivative) from producing a
    // non-physical hundreds-of-volts correction in one outer iteration.
    potentialRelaxation     0.25;
    maxFieldPotentialStep   0.02;  // V per outer iteration
}

// This case uses an effective anion-conducting potential.  The inherited
// Nafion dissolved-water model is intentionally disabled.
dissolveOnOff   false;

hydrogenCrossoverOnOff true;

hydrogenCrossover
{
    type        standard;

    standardCoeffs
    {
        // Hydrogen is generated at the physical cathode and crosses toward
        // the physical anode in electrolyzer operation.
        sourceZone      cathodeCL;
        sinkZone        anodeCL;

        i               i;
        j               J;

        // Names used by the conservative species-source mapping.  Mapping is
        // through the common parent mesh, not local region-cell ordering.
        cathodeFluidRegion  cathode;
        anodeFluidRegion    anode;
        hydrogenSpecies     H2;

        // Franz-style production partition: Faradaic H2 first enters the
        // dissolved-ionomer field. The identical local amount is removed
        // from the gas reaction source, so H2 is generated only once.
        faradaicDissolvedFraction  1.0;

        // J_H2,drag = nDrag*cH2*iIon/(zIon*F*cH2O). The constant drag
        // coefficient is the initial extension point for correlations.
        dragModel       constant;
        nDrag           1;
        zIon            -1;    // OH- charge number sets drag direction

        // Effective water molar concentration [mol/m3] in hydrated ionomer.
        // This provisional value requires AEM/KOH-specific calibration.
        cH2O            52000;

        // Select one of: constant, porosityTortuosity, bruggeman. The
        // hydrated-ionomer fraction is also the storage coefficient in
        // d(epsilonIon*cH2)/dt. These proof-of-concept values require
        // membrane- and CL-specific calibration.
        diffusivityModel    porosityTortuosity;
        DelecH2         4.5e-9;
        epsilonMembrane 0.2;
        epsilonCathodeCL 0.2;
        epsilonAnodeCL  0.2;
        tauMembrane     1;
        tauCathodeCL    1;
        tauAnodeCL      1;
        bruggemanExponent 1.5;

        // Initial concentration and fallback equilibrium concentrations
        // [mol/m3 of absorbed electrolyte] for fixed interface mode.
        cH2Initial      0.78;   // 1 bar-side initial dissolved H2 [mol/m3]
        cH2Anode        0.78;   // 1 bar anode-side dissolved H2 [mol/m3]
        cH2Cathode      7.8;    // 10 bar cathode-side dissolved H2 [mol/m3]

        cathodeInterface
        {
            type                henry;
            gasPhase            gas;
            // Equilibrium target c_sat = H*p_g*X_H2. It is used in the
            // signed finite-rate term kLa*(cH2-c_sat), not imposed as a
            // Dirichlet value in the catalyst layer.
            henryCoefficient    7.8e-6;
            // Effective volumetric coefficient kLa [1/s]. The selected value
            // lies within the 540--6500 1/s range fitted by Franz et al. for
            // Nafion cathode catalyst layers and remains an AEM sensitivity
            // assumption until matching permeation data are available.
            massTransferCoefficient 1500;
        }

        anodeInterface
        {
            type                henry;
            gasPhase            gas;
            // Same convention as cathodeInterface. H2 is a trace component
            // of the anode gas phase and rises through conservative
            // crossover coupling.
            henryCoefficient    7.8e-6;
            massTransferCoefficient 1.0; // kLa [1/s], calibrate for anode CL
        }

        relax           0.7;
    }
}


sigma
{
    // Effective OH- conductivity.  These baseline values reproduce the
    // former lambda=20 PEM correlation at 313.15 K: 11.4 in the membrane
    // and 1.10 after the porous-CL ionomer correction.  Calibrate them for
    // the selected AEM ionomer and electrolyte concentration.
    anodeCL
    {
        sigmaModel          constantSigma;

        constantSigmaCoeffs
        {
            cellZone            anodeCL;
            sigma               1.10;  // S/m
        }
    }

    cathodeCL
    {
        sigmaModel          constantSigma;

        constantSigmaCoeffs
        {
            cellZone            cathodeCL;
            sigma               1.10;  // S/m
        }
    }

    membrane
    {
        sigmaModel          constantSigma;
        constantSigmaCoeffs
        {
            cellZone            membrane;
            sigma               11.4;  // S/m
        }
    }
}
