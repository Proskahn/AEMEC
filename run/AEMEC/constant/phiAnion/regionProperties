FoamFile
{
    version         2.0;
    format          ascii;
    class           dictionary;
    object          cellProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//- Add information here

control          false;
relax           -4.0e-11;

// This case uses an effective anion-conducting potential.  The inherited
// Nafion dissolved-water model is intentionally disabled.
dissolveOnOff   false;

hydrogenCrossoverOnOff true;

hydrogenCrossover
{
    type        standard;

    standardCoeffs
    {
        // Hydrogen is generated at the physical cathode and crosses toward
        // the physical anode in electrolyzer operation.
        sourceZone      cathodeCL;
        sinkZone        anodeCL;

        i               i;
        j               J;

        // Water-drag coefficient in J_H2,drag = i/F*xi*cH2/cElec.
        xi              1;

        // 1 M KOH at 60 C from the reference text: 52 mol/l.
        cElec           52000;

        // D_eff = epsilonM/tau*DelecH2.
        DelecH2         4.5e-9;
        epsilonM        0.2;
        tau             1;

        // Dissolved H2 concentrations corresponding to the gas pressures.
        // Replace these with the selected H2 solubility/Henry relation if needed.
        cH2Initial      0.78;   // 1 bar-side initial dissolved H2 [mol/m3]
        cH2Anode        0.78;   // 1 bar anode-side dissolved H2 [mol/m3]
        cH2Cathode      7.8;    // 10 bar cathode-side dissolved H2 [mol/m3]

        // Optional implicit anode-side release/sink for stationary
        // closed-submesh runs.
        sinkCoeff       1.0;

        // The inherited ionic-current orientation is anode-to-cathode;
        // reverse it for cathode-to-anode hydrogen drag.
        dragSign        -1;
        relax           0.7;
    }
}


sigma
{
    anodeCL
    {
        sigmaModel          lambdaSigma;

        lambdaSigmaCoeffs
        {
            cellZone            anodeCL;
            catalyst            yes;

            porosity            0.3;
            porIonomer          0.3;
            lambdaName          lambda;
        }
    }

    cathodeCL
    {
        sigmaModel          lambdaSigma;

        lambdaSigmaCoeffs
        {
            cellZone            cathodeCL;
            catalyst            yes;

            porosity            0.3;
            porIonomer          0.3;
            lambdaName          lambda;
        }
    }

    membrane
    {
        sigmaModel          lambdaSigma;
        lambdaSigmaCoeffs
        {
            cellZone            membrane;
            lambdaName          lambda;
        }
    }
}
