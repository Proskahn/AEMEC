FoamFile
{
    version         2.0;
    format          ascii;
    class           dictionary;
    object          cellProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//- Add information here

control          false;
relax           -4.0e-11;

// This case uses an effective anion-conducting potential.  The inherited
// Nafion dissolved-water model is intentionally disabled.
dissolveOnOff   false;

hydrogenCrossoverOnOff true;

hydrogenCrossover
{
    type        standard;

    standardCoeffs
    {
        // Hydrogen is generated at the physical cathode and crosses toward
        // the physical anode in electrolyzer operation.
        sourceZone      cathodeCL;
        sinkZone        anodeCL;

        i               i;
        j               J;

        // Names used by the conservative species-source mapping.  Mapping is
        // through the common parent mesh, not local region-cell ordering.
        cathodeFluidRegion  cathode;
        anodeFluidRegion    anode;
        hydrogenSpecies     H2;

        // J_H2,drag = i/F*xi*cH2*/cElec.  The constant drag coefficient is
        // the initial extension point for hydration/temperature correlations.
        dragModel       constant;
        xi              1;

        // Nominal aqueous-carrier molar concentration [mol/m3] used by the
        // drag closure. Calibrate it with the selected KOH concentration.
        cElec           52000;

        // Select one of: constant, porosityTortuosity, bruggeman.
        // DelecH2 is D_H2^0 [m2/s].
        diffusivityModel    porosityTortuosity;
        DelecH2         4.5e-9;
        epsilonM        0.2;
        tau             1;
        bruggemanExponent 1.5;

        // Fallback dissolved H2 concentrations [mol/m3] for fixed interface
        // mode. The selected Henry interfaces below instead use c = H*p_H2,
        // where H is entered in mol/(m3 Pa), and are the active settings.
        cH2Initial      0.78;   // 1 bar-side initial dissolved H2 [mol/m3]
        cH2Anode        0.78;   // 1 bar anode-side dissolved H2 [mol/m3]
        cH2Cathode      7.8;    // 10 bar cathode-side dissolved H2 [mol/m3]

        cathodeInterface
        {
            type                henry;
            gasPhase            hydrogen;
            // c_H2,dissolved [mol/m3] = H [mol/(m3 Pa)] * p_H2 [Pa].
            henryCoefficient    7.8e-6;
        }

        anodeInterface
        {
            type                henry;
            gasPhase            oxygen;
            // Same convention as cathodeInterface. H2 is a trace component
            // of the anode oxygen phase and rises through conservative
            // crossover coupling.
            henryCoefficient    7.8e-6;
        }

        // Optional through-membrane convective velocity [m/s].  Keep zero
        // unless a validated pressure/permeability closure is supplied.
        UMembrane       (0 0 0);

        // Optional implicit anode-side release/sink for stationary
        // closed-submesh runs.
        sinkCoeff       1.0;

        // The inherited ionic-current orientation is anode-to-cathode;
        // reverse it for cathode-to-anode hydrogen drag.
        dragSign        -1;
        relax           0.7;
    }
}


sigma
{
    // Effective OH- conductivity.  These baseline values reproduce the
    // former lambda=20 PEM correlation at 313.15 K: 11.4 in the membrane
    // and 1.10 after the porous-CL ionomer correction.  Calibrate them for
    // the selected AEM ionomer and electrolyte concentration.
    anodeCL
    {
        sigmaModel          constantSigma;

        constantSigmaCoeffs
        {
            cellZone            anodeCL;
            sigma               1.10;
        }
    }

    cathodeCL
    {
        sigmaModel          constantSigma;

        constantSigmaCoeffs
        {
            cellZone            cathodeCL;
            sigma               1.10;
        }
    }

    membrane
    {
        sigmaModel          constantSigma;
        constantSigmaCoeffs
        {
            cellZone            membrane;
            sigma               11.4;
        }
    }
}
