FoamFile
{
    version         2.0;
    format          ascii;
    class           dictionary;
    object          cellProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//- Add information here

control           true;
relax             1.0e-6;

galvanostatic
{
    active      false;
    region      phiEAnode;
    patchName   interconnect0;
    maxVoltageStep 0.002;  // Maximum controller movement per outer iteration [V]

    // Default potentiostatic polarization scan: impose each collector
    // voltage for 15 s and measure the resulting current density.
    voltage
    {
        type    table;
        values
        (
            (0       1.3)
            (15      1.3)
            (15.001  1.5)
            (30      1.5)
            (30.001  1.7)
            (45      1.7)
            (45.001  1.9)
            (60      1.9)
            (60.001  2.1)
            (75      2.1)
            (75.001  2.3)
            (90      2.3)
        );
    }

    // Optional galvanostatic fallback. Electrolysis current is negative in
    // this solver convention; 2000 A/m2 = 0.2 A/cm2.
    ibar
    {
        type    table;
        values
        (
            (0        0)
            (15       0)
            (15.001   -2000)
            (30       -2000)
            (30.001   -4000)
            (45       -4000)
            (45.001   -6000)
            (60       -6000)
            (60.001   -8000)
            (75       -8000)
            (75.001   -10000)
            (90       -10000)
            (90.001   -12000)
            (105      -12000)
            (105.001  -14000)
            (120      -14000)
            (120.001  -16000)
            (135      -16000)
            (135.001  -18000)
            (150      -18000)
            (150.001  -20000)
            (165      -20000)
        );
    }

    // Optional convergence-based current scan. It is inactive during the
    // default voltage-table sweep.
    polarizationCurve
    {
        active                      false;
        targets                     (0 -2000 -4000 -6000 -8000 -10000 -12000 -14000 -16000 -18000 -20000);
        minimumHoldDuration         15;
        targetCurrentTolerance      0.05;
        currentScale                100;
        voltageTolerance            0.002;
        currentStabilityTolerance   0.02;
        stabilitySamples            5;
    }
}


sigma
{
    bpp
    {
        sigmaModel      constantSigma;

        constantSigmaCoeffs
        {
            cellZone        bpp;
            sigma           20000;
        }
    }

    anodeCL
    {
        sigmaModel      porousSigma;

        porousSigmaCoeffs
        {
            cellZone        anodeCL;
            catalyst        no;
            porosity        0.3;
            sigma           5000;
        }
    }

    anodeMPL
    {
        sigmaModel      porousSigma;

        porousSigmaCoeffs
        {
            cellZone        anodeMPL;
            catalyst        no;
            porosity        0.4;
            sigma           8000;
        }
    }

    anodeGDL
    {
        sigmaModel      porousSigma;

        porousSigmaCoeffs
        {
            cellZone        anodeGDL;
            catalyst        no;
            porosity        0.7;
            sigma           8000;
        }
    }
}
