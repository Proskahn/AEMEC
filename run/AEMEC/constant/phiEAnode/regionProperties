FoamFile
{
    version         2.0;
    format          ascii;
    class           dictionary;
    object          cellProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//- Add information here

control           true;
relax             1.0e-5;

galvanostatic
{
    active      false;
    region      phiEAnode;
    patchName   interconnect0;
    maxVoltageStep 0.01;   // Maximum controller movement per outer iteration [V]
    minVoltage  1.0;       // Physical safety bounds [V]
    maxVoltage  2.5;

    // Default polarization scan: hold each collector voltage for 15 s and
    // measure the resulting area-averaged current density.
    voltage
    {
        type    table;
        values
        (
            (0       1.3)
            (15      1.3)
            (15.001  1.5)
            (30      1.5)
            (30.001  1.7)
            (45      1.7)
            (45.001  1.9)
            (60      1.9)
            (60.001  2.1)
            (75      2.1)
            (75.001  2.3)
            (90      2.3)
        );
    }

    // Legacy time table used by single-target optimizer runs. The optimizer
    // disables polarizationCurve and rewrites this table to one direct hold.
    // Electrolysis current is negative in this solver convention.
    ibar
    {
        type    table;
        values
        (
            (0       0)
            (10      0)
            (10.001  -2000)
            (20      -2000)
            (20.001  -4000)
            (30      -4000)
            (30.001  -6000)
            (40      -6000)
            (40.001  -8000)
            (50      -8000)
            (50.001  -10000)
            (60      -10000)
            (60.001  -12500)
            (70      -12500)
            (70.001  -15000)
            (80      -15000)
        );
    }

    // A true polarization scan: do not advance a target simply because time
    // elapsed. The next target is selected only after the post-solve boundary
    // current is on target and both current and voltage are stable.
    polarizationCurve
    {
        active                      false;
        targets                     (-6000 -9000 -12000 -15000);
        minimumHoldDuration         15;
        targetCurrentTolerance      0.05;
        currentScale                100;
        voltageTolerance            0.002;
        currentStabilityTolerance   0.02;
        stabilitySamples            5;
    }
}


sigma
{
    bpp
    {
        sigmaModel      constantSigma;

        constantSigmaCoeffs
        {
            cellZone        bpp;
            sigma           20000;
        }
    }

    anodeCL
    {
        sigmaModel      porousSigma;

        porousSigmaCoeffs
        {
            cellZone        anodeCL;
            catalyst        no;
            porosity        0.3;
            sigma           5000;
        }
    }

    anodeMPL
    {
        sigmaModel      porousSigma;

        porousSigmaCoeffs
        {
            cellZone        anodeMPL;
            catalyst        no;
            porosity        0.4;
            sigma           8000;
        }
    }

    anodeGDL
    {
        sigmaModel      porousSigma;

        porousSigmaCoeffs
        {
            cellZone        anodeGDL;
            catalyst        no;
            porosity        0.7;
            sigma           8000;
        }
    }
}
