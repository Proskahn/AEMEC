FoamFile
{
    version         2.0;
    format          ascii;
    class           dictionary;
    object          cellProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//- Add information here

control           true;
relax             1.0e-6;
electricDiagnostics true;

galvanostatic
{
    active      true;
    region      phiEAnode;
    patchName   interconnect0;
    maxVoltageStep 0.002;  // Maximum controller movement per outer iteration [V]

    // Retained for the optimization adapter. It explicitly disables
    // galvanostatic control in its scratch case before using this table.
    voltage
    {
        type    table;
        values
        (
            (0       1.3)
            (15      1.3)
            (15.001  1.4)
            (30      1.4)
            (30.001  1.5)
            (45      1.5)
            (45.001  1.6)
            (60      1.6)
            (60.001  1.7)
            (75      1.7)
            (75.001  1.8)
            (90      1.8)
            (90.001  1.9)
            (105     1.9)
            (105.001 2.0)
            (120     2.0)
            (120.001 2.1)
            (135     2.1)
            (135.001 2.2)
            (150     2.2)
            (150.001 2.3)
            (165     2.3)
        );
    }

    // Fixed 1 A/cm2 crossover experiment. Electrolysis current is negative
    // in this solver convention, so 1 A/cm2 = -10000 A/m2.
    ibar
    {
        type    table;
        values
        (
            (0     -10000)
            (20    -10000)
        );
    }

    // Treat the single target as accepted only after the full 20 s experiment
    // and a stable final current/voltage window.
    polarizationCurve
    {
        active                      true;
        targets                     (-10000);
        minimumHoldDuration         20;
        targetCurrentTolerance      0.01;
        currentScale                100;
        voltageTolerance            0.002;
        currentStabilityTolerance   0.01;
        stabilitySamples            5;
    }
}


sigma
{
    bpp
    {
        sigmaModel      constantSigma;

        constantSigmaCoeffs
        {
            cellZone        bpp;
            sigma           20000;
        }
    }

    anodeCL
    {
        sigmaModel      porousSigma;

        porousSigmaCoeffs
        {
            cellZone        anodeCL;
            catalyst        no;
            porosity        0.3;
            sigma           5000;
        }
    }

    anodeMPL
    {
        sigmaModel      porousSigma;

        porousSigmaCoeffs
        {
            cellZone        anodeMPL;
            catalyst        no;
            porosity        0.4;
            sigma           8000;
        }
    }

    anodeGDL
    {
        sigmaModel      porousSigma;

        porousSigmaCoeffs
        {
            cellZone        anodeGDL;
            catalyst        no;
            porosity        0.7;
            sigma           8000;
        }
    }
}
