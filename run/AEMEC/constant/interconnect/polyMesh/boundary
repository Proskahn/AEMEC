FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "1/interconnect/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

5
(
    interconnect0
    {
        type            patch;
        nFaces          800;
        startFace       44000;
    }
    interconnectSides
    {
        type            patch;
        nFaces          3200;
        startFace       44800;
    }
    interconnect1
    {
        type            patch;
        nFaces          800;
        startFace       48000;
    }
    interconnect_to_anode
    {
        type            mappedWall;
        inGroups        1(wall);
        nFaces          1600;
        startFace       48800;
        sampleMode      nearestPatchFace;
        sampleRegion    anode;
        samplePatch     anode_to_interconnect;
    }
    interconnect_to_cathode
    {
        type            mappedWall;
        inGroups        1(wall);
        nFaces          1600;
        startFace       50400;
        sampleMode      nearestPatchFace;
        sampleRegion    cathode;
        samplePatch     cathode_to_interconnect;
    }
)

