FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "1/anode/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

5
(
    anodeInlet
    {
        type            patch;
        nFaces          100;
        startFace       45800;
    }
    anodeOutlet
    {
        type            patch;
        nFaces          100;
        startFace       45900;
    }
    anodeSides
    {
        type            patch;
        nFaces          1800;
        startFace       46000;
    }
    anode_to_interconnect
    {
        type            mappedWall;
        inGroups        1(wall);
        nFaces          1600;
        startFace       47800;
        sampleMode      nearestPatchFace;
        sampleRegion    interconnect;
        samplePatch     interconnect_to_anode;
    }
    anode_to_electrolyte
    {
        type            mappedWall;
        inGroups        1(wall);
        nFaces          800;
        startFace       49400;
        sampleMode      nearestPatchFace;
        sampleRegion    electrolyte;
        samplePatch     electrolyte_to_anode;
    }
)

