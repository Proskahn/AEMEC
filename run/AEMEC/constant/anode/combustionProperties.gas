FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      combustionProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

combustionModel electroChemicalReaction;

dissolved       false;

saturation
{
    type ArdenBuck;
}

activationOverpotentialModel
{
    type    ButlerVolmer;

    zoneName  anodeCL;

    phaseChange     true;

    regions
    {
        fluid
        {
            name    anode;
        }
        electron
        {
            name    phiEAnode;
        }
        anion
        {
            name    phiAnion;
        }
        dissolved
        {
            name    dissolved;
        }
    }

    species
    {
        O2
        {
            ksi     0;
            cRef    5.4;
        }
    }

    phiNames
    (
        electron    phi
        anion         phi
    );

    j0              120;
    // Numerical bound for this proof-of-concept case [A/m3].  It prevents an
    // uncalibrated initial overpotential from overflowing the flow solve.
    jMax            5.0e8;
    exponentLimit   50;
    // The ionic gauge is now solved by a bounded current-balance iteration,
    // so each scalar root evaluation must use the actual overpotential.
    relax           1.0;
    alpha           0.5;
    gamma           0;

    nernstModel
    {
        type        standard;

        pRef        101325;

        RxnList
        (
            O2      0.5
            H2O     1
            e       2
        );

    }
}



// ************************************************************************* //
