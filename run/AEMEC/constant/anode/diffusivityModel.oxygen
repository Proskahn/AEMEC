FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      diffusivityModel.oxygen;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

anodeChannel
{
    type            binaryFSG;

    binaryFSGCoeffs
    {
        Tname       T.oxygen;
        pName       p;
        speciesA    O2;
        speciesB    H2O;
    }
}

anodeGDL
{
    type              porousFSG;

    porousFSGCoeffs
    {
        Tname       T.oxygen;
        pName       p;
        alphaName   alpha.oxygen;
        speciesA    O2;     // diffusing species
        speciesB    H2O;     // background species
        porosity    0.7;
        tortuosity  1.15;
        dPore       dPore [0 1 0 0 0 0 0] 16.5e-06;   // pore size
        doBinary    false;
    }
}

anodeMPL
{
    type             porousFSG;

    porousFSGCoeffs
    {
        Tname       T.oxygen;
        pName       p;
        alphaName   alpha.oxygen;
        speciesA    O2;     // diffusing species
        speciesB    H2O;     // background species
        porosity    0.4;
        tortuosity  1.6;
        dPore       dPore [0 1 0 0 0 0 0] 46e-06;   // pore size
        doBinary    false;
    }
}

anodeCL
{
    type              porousFSG;

    porousFSGCoeffs
    {
        Tname       T.oxygen;
        pName       p;
        alphaName   alpha.oxygen;
        speciesA    O2;     // diffusing species
        speciesB    H2O;     // background species
        porosity    0.3;
        tortuosity  1.83;
        dPore       dPore [0 1 0 0 0 0 0] 36e-06;   // pore size
        doBinary    false;
    }
}

// ************************************************************************* //
