FoamFile
{
    version         2.0;
    format          ascii;
    class           dictionary;
    object          cellProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//- Add information here

control           true;
relax             1.0e-5;

galvanostatic
{
    active      true;
    region      phiEC;
    patchName   interconnect0;

    // Prescribed mean current density [A/m2].  Electrolysis current is
    // negative on the phiEC collector with this model's sign convention.
    // Each value is held for 10 s; the collector voltage is calculated.
    ibar
    {
        type    table;
        values
        (
            (0       0)
            (10      0)
            (10.001  -3000)
            (20      -3000)
            (20.001  -6000)
            (30      -6000)
            (30.001  -9000)
            (40      -9000)
            (40.001  -12000)
            (50      -12000)
            (50.001  -15000)
            (60      -15000)
            (60.001  -19000)
            (70      -19000)
            (70.001  -23000)
            (80      -23000)
        );
    }
}


sigma
{
    bpp
    {
        sigmaModel      constantSigma;

        constantSigmaCoeffs
        {
            cellZone        bpp;
            sigma           20000;
        }
    }

    ccl
    {
        sigmaModel      porousSigma;

        porousSigmaCoeffs
        {
            cellZone        ccl;
            catalyst        no;
            porosity        0.3;
            sigma           5000;
        }
    }

    cmpl
    {
        sigmaModel      porousSigma;

        porousSigmaCoeffs
        {
            cellZone        cmpl;
            catalyst        no;
            porosity        0.4;
            sigma           8000;
        }
    }

    cathode
    {
        sigmaModel      porousSigma;

        porousSigmaCoeffs
        {
            cellZone        cathode;
            catalyst        no;
            porosity        0.7;
            sigma           8000;
        }
    }
}
