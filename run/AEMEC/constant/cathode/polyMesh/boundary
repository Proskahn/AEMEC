FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "1/cathode/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

5
(
    cathodeSides
    {
        type            patch;
        nFaces          1800;
        startFace       45800;
    }
    cathodeInlet
    {
        type            patch;
        nFaces          100;
        startFace       47600;
    }
    cathodeOutlet
    {
        type            patch;
        nFaces          100;
        startFace       47700;
    }
    cathode_to_electrolyte
    {
        type            mappedWall;
        inGroups        1(wall);
        nFaces          800;
        startFace       47800;
        sampleMode      nearestPatchFace;
        sampleRegion    electrolyte;
        samplePatch     electrolyte_to_cathode;
    }
    cathode_to_interconnect
    {
        type            mappedWall;
        inGroups        1(wall);
        nFaces          1600;
        startFace       48600;
        sampleMode      nearestPatchFace;
        sampleRegion    interconnect;
        samplePatch     interconnect_to_cathode;
    }
)

