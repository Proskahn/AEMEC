FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      phaseProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type          basicTwoPhaseSystem;

phases (gas water);

// Gas and liquid retain separate phase fractions, velocities, and species,
// but share the spatially varying temperature solved by the parent energy
// equation. Both phases contribute storage, convection, and conductivity.
thermalEquilibrium true;
continuous water;

// Keep mechanical physics in the phase equations, but do not deposit
// gravity, pressure-work, or kinetic-energy terms as temperature sources.
includeMechanicalWorkInHeatSource false;

LTS
{
    maxCo               0.5;
    maxAlphaCo          5;

    rDeltaTSmoothingCoeff 0.05;
    rDeltaTDampingCoeff 0.5;
    nAlphaSpreadIter    0;
    nAlphaSweepIter     0;
    maxDeltaT           1;
}

gas
{
    type            reactingPhaseModel;
    diameterModel   isothermal;
    isothermalCoeffs
    {
        d0              3e-3;
        p0              1e5;
    }

    residualAlpha   1e-6;
}

water
{
    type            purePhaseModel;
    diameterModel constant;
    constantCoeffs
    {
        d               1e-4;
    }

    residualAlpha   1e-6;
}

blending
{
    default
    {
        type            linear;
        minFullyContinuousAlpha.gas 0.7;
        minPartlyContinuousAlpha.gas 0.3;
        minFullyContinuousAlpha.water 0.7;
        minPartlyContinuousAlpha.water 0.3;
    }

    heatTransfer
    {
        type            linear;
        minFullyContinuousAlpha.gas 1;
        minPartlyContinuousAlpha.gas 0;
        minFullyContinuousAlpha.water 1;
        minPartlyContinuousAlpha.water 0;
    }

}

surfaceTension
(
    (gas and water)
    {
        type            constant;
        sigma           0.07;
    }
);

aspectRatio
(
    (gas in water)
    {
        type            constant;
        E0              1.0;
    }

    (water in gas)
    {
        type            constant;
        E0              1.0;
    }
);

drag
(
    (gas in water)
    {
        type            SchillerNaumann;
        residualRe      1e-3;
        swarmCorrection
        {
            type        none;
        }
    }

    (water in gas)
    {
        type            SchillerNaumann;
        residualRe      1e-3;
        swarmCorrection
        {
            type        none;
        }
    }
);

virtualMass
(
//     (gas in water)
//     {
//         type            constantCoefficient;
//         Cvm             0.5;
//     }
//
//     (water in gas)
//     {
//         type            constantCoefficient;
//         Cvm             0.5;
//     }
);

heatTransfer
(
    (gas in water)
    {
        type spherical;
        residualAlpha 1e-4;
    }

    (water in gas)
    {
        type RanzMarshall;
        residualAlpha 1e-4;
    }
);


phaseTransfer
(
);

lift
(
);

wallLubrication
(
);

turbulentDispersion
(
);

// Minimum allowable pressure
pMin            10000;

// ************************************************************************* //
