FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      combustionProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// This dictionary is phase-qualified as combustionProperties.gas because the
// reacting phase is named "gas" in regionProperties.
combustionModel electroChemicalReaction;

dissolved       false;

saturation
{
    type ArdenBuck;
}

activationOverpotentialModel
{
    type    ButlerVolmer;

    zoneName  cathodeCL;

    // Hydrogen is generated as a gas phase in the cathode two-phase channel.
    phaseChange     true;

    regions
    {
        fluid
        {
            name    cathode;
        }
        electron
        {
            name    phiECathode;
        }
        anion
        {
            name    phiAnion;
        }
        dissolved
        {
            name    dissolved;
        }
    }

    species
    {
        H2
        {
            ksi     0;
            cRef    26.3;
        }
    }

    phiNames
    (
        electron    phi
        anion       phi
    );

    // Provisional Pt/C alkaline-HER baseline [A/m3].  A room-temperature
    // Pt/C result in 1 M KOH (25 ugPt/cm2, eta10=46 mV, b=99 mV/dec) implies
    // i0,geo~=3.4 mA/cm2.  Uniformly distributing that activity through this
    // 20 um catalyst layer gives j0~=1.7e6 A/m3 (Nature Communications 13,
    // 2022, DOI: 10.1038/s41467-022-33216-w).  Re-scale this value when the
    // actual Pt loading or ECSA is specified.
    j0              1.7e6;
    // Numerical safeguard for this proof-of-concept case [A/m3].  For the
    // 20 um catalyst layer, 2e9 A/m3 corresponds to a 4 A/cm2 ceiling, above
    // the intended polarization range.  It is not a physical limiting current.
    jMax            2.0e9;
    exponentLimit   50;
    // The ionic gauge is now solved by a bounded current-balance iteration,
    // so each scalar root evaluation must use the actual overpotential.
    relax           1.0;
    // With n=2 in this implementation, alpha=0.30 represents the reported
    // geometric Pt/C Tafel slope of approximately 99 mV/dec at room temperature.
    alpha           0.30;
    gamma           0;

    nernstModel
    {
        type        standard;

        pRef        101325;

        RxnList
        (
            // Cathode: 2 H2O + 2 e- -> H2 + 2 OH-.
            // OH- is represented by the effective anion-potential region.
            H2      1
            H2O    -2
            e      -2
        );
    }
}
// ************************************************************************* //
