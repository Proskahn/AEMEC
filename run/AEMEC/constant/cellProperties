FoamFile
{
    version         2.0;
    format          ascii;
    class           dictionary;
    object          cellProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

nx    4;
ny    1;

// Solve a spatially varying conjugate temperature.  The anode and cathode
// regionProperties select local thermal equilibrium so gas and liquid share
// this temperature while retaining separate flow and species equations.
solveEnergy             true;

// Used only if solveEnergy is switched off for an isothermal diagnostic.
isothermalTemperature   313.15;

