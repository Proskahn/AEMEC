set logscale y
set title "/*---------------------------------------------------------------------------*\"
set ylabel 'Residual'
set xlabel 'Iteration'
plot \
"< cat log.run | grep 'Solving for Ux.gas' | cut -d' ' -f9 | tr -d ','" every 2 title 'Ux anode' with lines,\
"< cat log.run | grep 'Solving for p_rgh' | cut -d' ' -f9 | tr -d ','" every 8 title 'p' with lines,\
"< cat log.run | grep 'Solving for O2.gas' | cut -d' ' -f9 | tr -d ','" every 1 title 'YO2 anode' with lines,\
"< cat log.run | grep 'Solving for H2,' | cut -d' ' -f9 | tr -d ','" every 1 title 'YH2' with lines,\
"< cat log.run | grep 'Solving for H2O.gas' | cut -d' ' -f9 | tr -d ','" every 1 title 'YH2O anode' with lines,\
"< cat log.run | grep 'Solving for T' | cut -d' ' -f9 | tr -d ','" title 'T' with lines,\
"< cat log.run | grep 'Solving for phi' | cut -d' ' -f9 | tr -d ','" every 3 title 'phi' with lines

pause 1
reread
