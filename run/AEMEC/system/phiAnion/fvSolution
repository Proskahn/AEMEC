FoamFile
{
    version         2.0;
    format          ascii;
    class           dictionary;
    object          fvSolution;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    phi
    {
        // The implicit Butler-Volmer slope makes this equation symmetric
        // positive definite. DICPCG resolves the weak-kinetics startup case
        // reliably; GAMG previously stalled before reaching tolerance.
        solver           PCG;
        preconditioner   DIC;
        tolerance        1e-11;
        relTol           0;
        maxIter          1000;
    }

    cH2
    {
        solver           PBiCGStab;
        preconditioner   DILU;
        tolerance        1e-11;
        relTol           0;
        maxIter          100;
    }
}


PHI
{
    phiRefCell        0;
    phiRefValue       0;
}

PISO
{
    nIteration      0;
    nCorrectors    	1;
    nNonOrthogonalCorrectors 0;
    pRefCell        0;
    pRefValue       0;
}

relaxationFactors
{
//    phi                 0.8;
}


