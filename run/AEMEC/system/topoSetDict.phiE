FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

actions
(
    {
        name    phiEAnode;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        sourceInfo
        {
            set interconnect;
        }
    }
    {
        name    phiEAnode;
        type    cellZoneSet;
        action  add;
        source  setToCellZone;
        sourceInfo
        {
            set anodeGDL;
        }
    }
    {
        name    phiEAnode;
        type    cellZoneSet;
        action  add;
        source  setToCellZone;
        sourceInfo
        {
            set anodeMPL;
        }
    }
    {
        name    phiEAnode;
        type    cellZoneSet;
        action  add;
        source  setToCellZone;
        sourceInfo
        {
            set anodeCL;
        }
    }
    {
        name    phiEAnode;
        type    cellZoneSet;
        action  delete;
        source  boxToCell;
        sourceInfo
        {
            box (-10 -10 -10)(10 10 0);
        }
    }

    {
        name    phiECathode;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        sourceInfo
        {
            set interconnect;
        }
    }
    {
        name    phiECathode;
        type    cellZoneSet;
        action  add;
        source  setToCellZone;
        sourceInfo
        {
            set cathodeGDL;
        }
    }
    {
        name    phiECathode;
        type    cellZoneSet;
        action  add;
        source  setToCellZone;
        sourceInfo
        {
            set cathodeMPL;
        }
    }
    {
        name    phiECathode;
        type    cellZoneSet;
        action  add;
        source  setToCellZone;
        sourceInfo
        {
            set cathodeCL;
        }
    }
    {
        name    phiECathode;
        type    cellZoneSet;
        action  delete;
        source  boxToCell;
        sourceInfo
        {
            box (-10 -10 0)(10 10 10);
        }
    }

    {
        name    phiE0;
        type    cellZoneSet;
        action  new;
        source  boxToCell;
        sourceInfo
        {
            box (-10 -10 -10)(10 10 10);
        }
    }
    {
