FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "80/fuel";
    object      alpha;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    anodeSides
    {
        type            calculated;
        value           uniform 1;
    }
    fuelInlet
    {
        type            calculated;
        value           uniform 1;
    }
    fuelOutlet
    {
        type            calculated;
        value           uniform 1;
    }
    fuel_to_electrolyte
    {
        type            calculated;
        value           uniform 1;
    }
    fuel_to_interconnect
    {
        type            calculated;
        value           uniform 1;
    }
}


