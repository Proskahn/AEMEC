FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    object          phi;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [1 2 -3 0 0 -1 0];

// A 1.3--1.5 V AEM electrolyzer starts near 3 V on this model's signed
// Nernst-potential convention. The current-balance solve refines the gauge.
internalField   uniform 3.0;

boundaryField
{
    ".*"
    {
        type            zeroGradient;
    }
}


