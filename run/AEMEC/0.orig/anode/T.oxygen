FoamFile
{
    version         2.0;
    format          ascii;

    root            "";
    case            "";
    instance        "";
    local           "";

    class           volScalarField;
    object          T;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 0 0 1 0 0 0];

internalField   uniform 313.15;

boundaryField
{

    anodeInlet
    {
        type            fixedValue;
        value           $internalField;
    }

    anodeOutlet
    {
        type            inletOutlet;
        phi             phi.oxygen;
        inletValue      $internalField;
        value           $internalField;
    }

    anodeSides
    {
        type            zeroGradient;
    }

    anodeInletSides
    {
        type            zeroGradient;
    }

    anodeOutletSides
    {
        type            zeroGradient;
    }

    anodeGDLSides
    {
        type            zeroGradient;
    }

    anode_to_interconnect
    {
        type            zeroGradient;
//        type            copiedFixedValue;
//        sourceFieldName T.water;
//        value           $internalField;
    }

    anode_to_electrolyte //anodeGDL
    {
        type            zeroGradient;
//        type            copiedFixedValue;
//        sourceFieldName T.water;
//        value           $internalField;
    }
}


