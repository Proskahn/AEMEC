FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    object          yH2O;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.04234;

boundaryField
{
    anodeInlet
    {
        type            fixedValue;
        value           $internalField;
    }

    anodeOutlet
    {
        type            inletOutlet;
        phi             phi.oxygen;
        inletValue      $internalField;
        value           $internalField;
    }

    anodeSides
    {
        type            zeroGradient;
    }

    anodeInletSides
    {
        type            zeroGradient;
    }

    anodeOutletSides
    {
        type            zeroGradient;
    }

    anodeGDLSides
    {
        type            zeroGradient;
    }

    anode_to_electrolyte
    {
        type            zeroGradient;
    }

    anode_to_interconnect
    {
        type            zeroGradient;
    }
}


// ************************************************************************* //
