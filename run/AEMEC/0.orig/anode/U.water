FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0/anode";
    object      U.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

// The liquid phase represents aqueous KOH at the present model fidelity.
// KOH concentration/density and explicit solute transport are not yet solved.
internalField   uniform (0.01 0 0);

boundaryField
{
    anodeInlet
    {
        type            fixedValue;
        value           uniform (0.01 0 0);
    }
    anodeOutlet
    {
        type            pressureInletOutletVelocity;
        phi             phi.water;
        value           $internalField;
    }
    anodeSides
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    anode_to_electrolyte
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    anode_to_interconnect
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
}


// ************************************************************************* //
