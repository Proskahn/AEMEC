FoamFile
{
    version         2.0;
    format          ascii;

    root            "";
    case            "";
    instance        "";
    local           "";

    class           volScalarField;
    object          p;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325;

boundaryField
{

    anodeInlet
    {
        type               zeroGradient;
        value              $internalField;
    }

    anodeOutlet
    {
        type               prghPressure;
        p                  $internalField;
        p0                 $internalField;
        value              $internalField;
    }

    anodeSides
    {
        type               zeroGradient;
        value              $internalField;
    }

    anodeInletSides
    {
        type               zeroGradient;
        value              $internalField;
    }

    anodeOutletSides
    {
        type               zeroGradient;
        value              $internalField;
    }

    anodeGDLSides
    {
        type               zeroGradient;
        value              $internalField;
    }

    anode_to_interconnect
    {
        type               zeroGradient;
        value              $internalField;
    }

    anode_to_electrolyte //anodeGDL
    {
        type               zeroGradient;
        value              $internalField;
    }
}


