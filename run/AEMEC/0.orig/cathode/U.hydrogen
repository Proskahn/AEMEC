FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0/cathode";
    object      U.hydrogen;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0.01 0 0);

boundaryField
{
    cathodeInlet
    {
        type            fixedValue;
        value           uniform (0.01 0 0);
    }
    cathodeOutlet
    {
        type            pressureInletOutletVelocity;
        phi             phi.hydrogen;
        value           $internalField;
    }
    cathodeSides
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    cathode_to_electrolyte
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    cathode_to_interconnect
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
}


// ************************************************************************* //
