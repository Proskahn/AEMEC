FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/cathode";
    object      alpha.hydrogen;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

// Keep a trace gas phase so two-phase mixture properties remain defined at
// startup; electrolysis-generated hydrogen subsequently evolves from this seed.
internalField   uniform 1e-4;

boundaryField
{
    cathodeInlet
    {
        type            fixedValue;
        value           uniform 1e-4;
    }
    cathodeOutlet
    {
        type            inletOutlet;
        phi             phi.hydrogen;
        inletValue      uniform 1e-4;
        value           uniform 1e-4;
    }
    cathodeSides
    {
        type            zeroGradient;
    }
    cathode_to_interconnect
    {
        type            zeroGradient;
    }
    cathode_to_electrolyte
    {
        type            zeroGradient;
    }
}


// ************************************************************************* //
