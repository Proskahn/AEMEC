FoamFile
{
    version         2.0;
    format          ascii;

    root            "";
    case            "";
    instance        "";
    local           "";

    class           volScalarField;
    object          T;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 0 0 1 0 0 0];

internalField   uniform 313.15;

boundaryField
{

    cathodeInlet
    {
        type            fixedValue;
        value           $internalField;
    }

    cathodeOutlet
    {
        type            inletOutlet;
        phi             phi.water;
        inletValue      $internalField;
        value           $internalField;
    }

    cathodeSides
    {
        type            zeroGradient;
    }

    cathodeInletSides
    {
        type            zeroGradient;
    }

    cathodeOutletSides
    {
        type            zeroGradient;
    }

    cathodeGDLSides
    {
        type            zeroGradient;
    }

    cathode_to_interconnect
    {
        type            copiedFixedValue;
        sourceFieldName T.gas;
        value           $internalField;
    }

    cathode_to_electrolyte //anodeGDL
    {
        type            copiedFixedValue;
        sourceFieldName T.gas;
        value           $internalField;
    }
}


// ************************************************************************* //
