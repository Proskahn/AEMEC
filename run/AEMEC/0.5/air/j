FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0.5/air";
    object      j;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 -3 0 0 0 1 0];

internalField   uniform 0;

boundaryField
{
    airInlet
    {
        type            calculated;
        value           uniform 0;
    }
    airOutlet
    {
        type            calculated;
        value           uniform 0;
    }
    cathodeSides
    {
        type            calculated;
        value           uniform 0;
    }
    air_to_interconnect
    {
        type            calculated;
        value           uniform 0;
    }
    air_to_electrolyte
    {
        type            calculated;
        value           uniform 0;
    }
}


