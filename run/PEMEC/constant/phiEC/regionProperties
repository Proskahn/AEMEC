FoamFile
{
    version         2.0;
    format          ascii;
    class           dictionary;
    object          cellProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//- Add information here

control           true;
relax             1.0e-5;

galvanostatic
{
    active      false;
    region      phiEC;
    patchName   interconnect0;

    voltage
    {
        type    table;
        values
        (
            (0      1.3)
            (10     1.3)
            (10.001 1.4)
            (20     1.4)
            (20.001 1.5)
            (30     1.5)
            (30.001 1.6)
            (40     1.6)
            (40.001 1.7)
            (50     1.7)
            (50.001 1.8)
            (60     1.8)
            (60.001 1.9)
            (70     1.9)
            (70.001 2.0)
            (80     2.0)
        );
    }
}


sigma
{
    bpp
    {
        sigmaModel      constantSigma;

        constantSigmaCoeffs
        {
            cellZone        bpp;
            sigma           20000;
        }
    }

    ccl
    {
        sigmaModel      porousSigma;

        porousSigmaCoeffs
        {
            cellZone        ccl;
            catalyst        no;
            porosity        0.3;
            sigma           5000;
        }
    }

    cmpl
    {
        sigmaModel      porousSigma;

        porousSigmaCoeffs
        {
            cellZone        cmpl;
            catalyst        no;
            porosity        0.4;
            sigma           8000;
        }
    }

    cathode
    {
        sigmaModel      porousSigma;

        porousSigmaCoeffs
        {
            cellZone        cathode;
            catalyst        no;
            porosity        0.7;
            sigma           8000;
        }
    }
}
